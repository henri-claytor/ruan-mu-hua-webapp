# Google OAuth Client ID（非機密，前後端共用同一組值；過渡期 Google 登入用，統登接上後可移除）
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# Google Service Account 的 JSON 金鑰內容（整包 JSON 貼成一行字串），供後端存取 Google Drive 用【高機密】
GOOGLE_SERVICE_ACCOUNT_JSON=

# 報告來源：Google 雲端硬碟資料夾 ID（後端列出此資料夾內的報告）
GOOGLE_DRIVE_FOLDER_ID=

# 簽發 session JWT 用的密鑰，任意足夠長的隨機字串即可【機密】
SESSION_JWT_SECRET=

# 開發過渡開關：略過登入直接放行（統登尚未接時，僅供本機開發用）
# ⚠️ 正式站不要設此變數 —— 設了會關掉所有登入檢查、讓報告變公開
# AUTH_BYPASS=true
# VITE_AUTH_BYPASS=true
